                        <div className="grid grid-cols-[repeat(auto-fit,minmax(300px, 1fr)] gap-4">
                            {subscriptions?.map((sub, i) =>
                                sub?.subscription?.id > 1 &&
                                <SubscriptionCard
                                    key={i}
                                    tariff={sub.subscription}
                                    startAt={sub.start_at}
                                    endAt={sub.end_at}
                                    canceled={sub.canceled}
