/**
 * Converts an amount in Russian Rubles (RUB) to Bitcoin (BTC)
 * using the CoinGecko API for the current exchange rate.
 *
 * @param rubles - Amount in RUB
 * @returns Promise that resolves to the equivalent amount in BTC
 * @throws If the API request fails or returns invalid data
 */
export async function convertRubToBtc(rubles: number): Promise<number> {
  const response = await fetch(
    'https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=rub'
  );

  if (!response.ok) {
    throw new Error('Failed to fetch BTC/RUB rate');
  }

  const data = await response.json();
  const rate = data?.bitcoin?.rub;

  if (typeof rate !== 'number') {
    throw new Error('Invalid rate data');
  }

  return rubles / rate;
}
```

