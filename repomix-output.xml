                <form onSubmit={handleSubmit} className="flex flex-col gap-[10px] mt-[20px] w-full">

                    <Input
                        label={"Почта"}
                        placeholder={"ivanov@gmail.com"}
                        name={"email"}
                        error={errors?.email}
                    />

                    <Input
                        label={"Пароль"}
                        type_="password"
                        name={"password"}
                        error={errors?.password}
                        isOpen={isOpen}
                        setIsOpen={setIsOpen}
                    />

                    <Link href="/otp" className="w-full text-text-main font-bold text-small">
