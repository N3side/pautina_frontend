<file path="src/app/globals.css">
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap');
@tailwind utilities;
@import "tailwindcss";

/* 1. Дефолтные переменные (Светлая тема) */
:root {

	--bg-page: rgba(250, 250, 250, 1);
	--bg-card: #ffffff;
	--bg-input: #ffffff;
	--text-main: #0f172a;
	--text-muted: #64748b;
	--text-brand: #0ea5e9;
	--brand-primary: #0ea5e9;
	--brand-hover: #0284c7;
	--green-main: #16A34A;
	--border-default: #e2e8f0;
	--bg-glass: rgba(255, 255, 255, 0.95);
	--border-glass: lab(88.4% 0 .0000119209);

	/* Переменные для симуляции преломления света (Фаски) */
	--glass-bevel-top: rgba(255, 255, 255, 0.75);    /* Яркий блик на верхнем ребре */
	--glass-bevel-bottom: rgba(15, 23, 42, 0.04);   /* Мягкая тень на нижнем ребре */
	--glass-inner-glow: rgba(255, 255, 255, 0.25);  /* Внутреннее свечение стекла */
	--glass-shadow: rgba(14, 165, 233, 0.08);;

	--subscription-color: linear-gradient(
		315deg,
		rgba(148, 139, 250, 1),
		rgba(14, 165, 233, 1)
	);
}

.dark {
	--bg-page: radial-gradient(at 0% 0%, rgba(14, 165, 233, 0.15) 0px, transparent 50%),
	radial-gradient(at 100% 100%, rgba(79, 70, 229, 0.1) 0px, transparent 50%),
	linear-gradient(180deg, #020617 0%, #0a0a14 100%);
	--bg-card: #1e293b;
	--bg-input: #1e293b;
	--text-main: #f8fafc;
	--text-muted: #94a3b8;
	--text-brand: #38bdf8;
	--border-default: #334155;
	--bg-glass: rgba(15, 23, 42, 0.95);
	--border-glass: rgba(255, 255, 255, 0.09);
	--glass-highlight: rgba(255, 255, 255, 0.04);
	--glass-bevel-top: rgba(255, 255, 255, 0.28);   /* Блик на темном стекле */
	--glass-bevel-bottom: rgba(0, 0, 0, 0.4);        /* Глубокая тень внизу */
	--glass-inner-glow: rgba(255, 255, 255, 0.03);  /* Едва заметный внутренний контур */
	--glass-shadow: rgba(0, 0, 0, 0.5);
}

@theme {
	--color-background: var(--bg-page);
	--color-surface: var(--bg-card);
	--color-input: var(--bg-input);

	--color-text-main: var(--text-main);
	--color-text-muted: var(--text-muted);
	--color-text-brand: var(--text-brand);

	--color-border-default: var(--border-default);
	--color-brand: var(--brand-primary);
	--color-brand-hover: var(--brand-hover);

	--color-green-main: var(--green-main);

	--color-glass-bg: var(--bg-glass);
	--color-glass-border: var(--border-glass);

	--font-montserrat: "Montserrat", sans-serif;
}

@layer utilities {
	.glass-effect {
		background: var(--bg-glass);

		/* Выкручиваем сочность бэкграунда как в iOS (saturate 220%) */
		backdrop-filter: blur(40px) saturate(220%);
		-webkit-backdrop-filter: blur(40px) saturate(220%);

		/* Базовая тонкая нить вокруг всей карточки */
		border: 1px solid var(--border-glass);

		/* Секретная оптика Apple: */
		box-shadow:
			/* 1. Тот самый верхний блик. За счет смещения по Y (1.2px) он ложится только на верх и углы,
                 визуально "сужая" боковые рамки */
				inset 0 1.2px 0 0 var(--glass-bevel-top),

					/* 2. Нижнее полупрозрачное затемнение (карточка обретает вес снизу) */
				inset 0 -1px 2px 0 var(--glass-bevel-bottom),

					/* 3. Внутренний контур, который сглаживает переход */
				inset 0 -1 2px 0 var(--glass-inner-glow),

					/* 4. Объемные внешние тени для эффекта парения */
				0 4px 6px -1px rgba(0, 0, 0, 0.05),
				0 20px 40px -10px var(--glass-shadow);

		/* Важно: предотвращает "вылезание" фонового цвета за скругленные края рамки на Retina-дисплеях */
		background-clip: padding-box;

		transform: translateZ(0);
	}

	.custom-scrollbar {
		scrollbar-width: none;
		scrollbar-color: var(--border-default) transparent;
	}

	.custom-scrollbar::-webkit-scrollbar-track {
		background: transparent;
	}

	.custom-scrollbar::-webkit-scrollbar-thumb {
		background-color: var(--border-default);
		border-radius: 10px;
	}

	.custom-scrollbar::-webkit-scrollbar-thumb:hover {
		background-color: var(--text-muted);
	}

}

@utility no-scrollbar {
	@apply [scrollbar-width:none] [&::-webkit-scrollbar]:hidden;
}

@layer base {
	h1,h2,h3,h4,h5,h6,.text-large, .text-default, .text-secondary, .text-small, .text-small {
		@apply font-montserrat;
	}

	h1 { font-size: clamp(34px, 1.625vw + 28.800px, 60px); line-height: 1; }
	h2 { font-size: 3rem; line-height: 1.1; }
	h3 { font-size: clamp(28px, 0.750vw + 25.600px, 40px); }
	h4 { font-size: clamp(22px, 0.500vw + 20.400px, 30px); line-height: 1.2; }
	h5 { font-size: clamp(20px, 0.250vw + 19.200px, 24px); }
	h6 { font-size: clamp(16px, 0.250vw + 15.200px, 20px); }

	.text-large { font-size: clamp(16px, 0.250vw + 15.200px, 20px); }
	.text-default { font-size: clamp(16px, 0.125vw + 15.600px, 18px); }
	.text-secondary { font-size: clamp(14px, 0.125vw + 13.600px, 16px); }
	.text-small { font-size: clamp(12px, 0.125vw + 11.600px, 14px); }
	.text-tiny { font-size: clamp(10px, 0.125vw + 9.600px, 12px); }

	.text-button-lg { font-size: clamp(14px, 0.250vw + 13.200px, 18px); @apply font-montserrat font-bold; }
	.text-button-sm { font-size: clamp(12px, 0.125vw + 11.600px, 14px); @apply font-montserrat font-bold; }

	.text-label {
		font-size: clamp(10px, 0.125vw + 9.600px, 12px);
		@apply font-semibold font-montserrat uppercase tracking-wider text-text-muted ml-1 mb-0.5;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
		outline: none;
		border: none;
		list-style: none;
	}

	button { cursor: pointer; }

	body {
		min-height: 100vh;
		height: 100%;
		width: 100vw;
		background: var(--bg-page);
		background-repeat: no-repeat;
		overflow-x: clip;
		@apply overflow-y-scroll;

		/* Стилизация скроллбара (Светлая тема по умолчанию) */
		&::-webkit-scrollbar { width: 6px; }
		&::-webkit-scrollbar-track { @apply bg-gray-100; }
		&::-webkit-scrollbar-thumb { @apply bg-gray-300; }
	}

	/* Стилизация скроллбара (Темная тема) */
	.dark body::-webkit-scrollbar-track {
		@apply bg-neutral-700;
	}
	.dark body::-webkit-scrollbar-thumb {
		@apply bg-neutral-500;
	}
}

body {
	overflow-x: clip;
	position: relative;
	max-width: 100vw;
	width: 100%;
}

html {
	scrollbar-gutter: stable;
	overflow-x: clip;
}

/* Глобальный стиль для всех тостов */
.custom-hot-toast {
	background: rgba(5, 74, 175, .9) !important;
	border: 2px solid var(--text-brand) !important;
	border-radius: 12px !important;
	padding: 12px 24px !important;
	padding-right: 100px !important;
	color: white !important;
	display: flex !important;
	flex-direction: column !important;
	align-items: flex-start !important;
	box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.3) !important;
	font-weight: 600;
}

.custom-hot-toast [role="status"] { margin: 0; }
.custom-hot-toast::before {
	font-family: var(--font-montserrat);
	content: 'ⓘ СООБЩЕНИЕ';
	display: block;
	font-size: 10px;
	font-weight: 900;
	opacity: 0.8;
	margin-bottom: 4px;
	letter-spacing: 0.15em;
}
.custom-hot-toast > div:first-child { display: none !important; }

input::-ms-reveal,
input::-ms-clear { display: none; }
input::-webkit-contacts-auto-fill-button,
input::-webkit-credentials-auto-fill-button {
	visibility: hidden;
	display: none !important;
	pointer-events: none;
	position: absolute;
	right: 0;
}
input::-webkit-caps-lock-indicator,
input::-webkit-strong-password-auto-fill-button { display: none !important; }
